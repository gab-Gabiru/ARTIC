FROM dunglas/frankenphp:php8.4-bookworm

# Vercel uses its own container health/readiness handling. Disable the base
# image HEALTHCHECK so OCI builds do not emit a misleading warning.
HEALTHCHECK NONE

ENV DEBIAN_FRONTEND=noninteractive \
    COMPOSER_ALLOW_SUPERUSER=1 \
    PORT=80

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg2 \
        apt-transport-https \
        unixodbc-dev \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && pecl install sqlsrv pdo_sqlsrv \
    && docker-php-ext-enable sqlsrv pdo_sqlsrv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Caddyfile /etc/caddy/Caddyfile
COPY . /app

# Keep the local upload path writable for small/demo uploads. Vercel's
# container filesystem is ephemeral; persistent production uploads should use
# Vercel Blob or another object store.
RUN mkdir -p /app/uploads \
    && chown -R www-data:www-data /app /config /data 2>/dev/null || true

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
